# Reference list of every setting with its default (ADR 0003 table is the source of truth).
# compose.yaml reads only LOG_LEVEL and CONSUMER_WORKERS from .env; every other value is set in the
# service's `environment:` block in compose.yaml (edit it there). Running a binary outside Compose reads all of them; the keys that differ per service are called out below.
# Secrets are NOT set here: they are mounted as files (deploy/secrets/*.example).

# --- both services ---
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Listen address. Producer default :8080; consumer default :8081 (health/metrics, not published).
HTTP_ADDR=:8080
# Comma-separated Kafka bootstrap brokers.
KAFKA_BROKERS=kafka:9092
# Topic carrying user activity events.
KAFKA_TOPIC=incoming.user_activity
# Max time to wait for dependencies (Kafka/Postgres) at startup.
STARTUP_TIMEOUT=60s

# --- producer ---
# Max time to wait for Kafka to acknowledge a publish before answering 503.
PUBLISH_TIMEOUT=5s
# Max time to drain in-flight work on shutdown (producer default 5s).
DRAIN_TIMEOUT=5s
# Max time for the HTTP server to shut down; must exceed PUBLISH_TIMEOUT (producer default 12s).
HTTP_SHUTDOWN_TIMEOUT=12s

# --- consumer: shutdown ---
# DRAIN_TIMEOUT and HTTP_SHUTDOWN_TIMEOUT have different defaults per service and a key cannot
# appear twice here, so the consumer's values are commented out. Uncomment them (and comment the
# producer's) when running the consumer binary from this file.
# Max time to flush batches, commit and leave the group on shutdown.
# DRAIN_TIMEOUT=15s
# Max time for the health/metrics server to shut down.
# HTTP_SHUTDOWN_TIMEOUT=5s

# --- consumer: Kafka ---
# Dead-letter topic for permanently failing records.
KAFKA_DLQ_TOPIC=incoming.user_activity.dlq
# Consumer group id; scale by running more consumers with the same group.
CONSUMER_GROUP=analytics-consumer
# Group members (goroutines) per consumer process.
CONSUMER_WORKERS=3
# Static group membership: stable identity of this replica; member i joins as <id>-<i>.
# Unset = the hostname (every Compose replica has its own; a restarted container keeps it).
# Must be unique per replica: [a-zA-Z0-9._-], at most 240 characters.
# CONSUMER_INSTANCE_ID=
# A replica that dies without leaving holds its partitions this long; a restart within it
# takes them back at once (6s..30m).
CONSUMER_SESSION_TIMEOUT=30s
# Flush a batch to Postgres at least this often...
FLUSH_INTERVAL=1s
# ...or when it reaches this many records.
FLUSH_MAX_RECORDS=500
# Max time for one flush attempt (DLQ publish + transaction); a timeout is retried.
# Must be >= DATABASE_STATEMENT_TIMEOUT.
FLUSH_TIMEOUT=10s
# Max time to flush pending batches when a partition is revoked.
REVOKE_FLUSH_TIMEOUT=10s
# Exponential backoff bounds for transient failures.
RETRY_BASE_DELAY=100ms
RETRY_MAX_DELAY=10s

# --- consumer: PostgreSQL ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=analytics
# Runtime role. The `migrate` subcommand needs DDL rights: outside Compose set
# DATABASE_USER=analytics_owner (compose.yaml does this for consumer-migrate).
DATABASE_USER=analytics_app
# Password is read from this file (Compose secret). For `migrate` set
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_owner_password.
DATABASE_PASSWORD_FILE=/run/secrets/analytics_app_password
# disable for local Compose; use verify-full in production.
DATABASE_SSLMODE=disable
# Connection pool bounds.
DATABASE_MAX_CONNS=8
DATABASE_MIN_CONNS=1
# Per-statement timeout.
DATABASE_STATEMENT_TIMEOUT=5s
