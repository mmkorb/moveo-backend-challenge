# Postgres is the bottleneck: 0.25 CPU, everything else as in equal.env.
# LT_USERS=200000 spreads the events over many distinct (date, user) rows, so every batch upserts
# many rows instead of a few hot ones (the default pool is 5000 users).
# Expect: flush duration up, consumer lag grows, long drain; the producer is unaffected.
LT_USERS=200000
LT_PRODUCER_CPUS=1.5
LT_PRODUCER_MEMORY=1.25G
LT_PRODUCER_GOMEMLIMIT=1150MiB
LT_CONSUMER_CPUS=1.5
LT_CONSUMER_MEMORY=1.25G
LT_CONSUMER_GOMEMLIMIT=1150MiB
LT_KAFKA_CPUS=1.5
LT_KAFKA_MEMORY=1.25G
LT_POSTGRES_CPUS=0.25
LT_POSTGRES_MEMORY=1.25G
LT_K6_CPUS=2
