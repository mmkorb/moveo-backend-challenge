# Baseline: every component gets the same CPU and memory, so none is the intended bottleneck.
# Plain KEY=value lines, only LT_* keys, no quotes or inline comments. Variables already set in
# the environment win over this file (loadtest/run.sh --profile).
LT_PRODUCER_CPUS=1.5
LT_PRODUCER_MEMORY=1.25G
LT_PRODUCER_GOMEMLIMIT=1150MiB
LT_CONSUMER_CPUS=1.5
LT_CONSUMER_MEMORY=1.25G
LT_CONSUMER_GOMEMLIMIT=1150MiB
LT_KAFKA_CPUS=1.5
LT_KAFKA_MEMORY=1.25G
LT_POSTGRES_CPUS=1.5
LT_POSTGRES_MEMORY=1.25G
# k6 gets 2 CPUs so the load generator is not the limit at high rates.
LT_K6_CPUS=2
