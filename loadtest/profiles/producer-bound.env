# Producer is the bottleneck: 0.5 CPU, everything else as in equal.env.
# Expect: producer CPU pinned near 50 %, p95 latency up, dropped iterations; consumer unaffected.
LT_PRODUCER_CPUS=0.5
LT_PRODUCER_MEMORY=1.25G
LT_PRODUCER_GOMEMLIMIT=1150MiB
LT_CONSUMER_CPUS=1.5
LT_CONSUMER_MEMORY=1.25G
LT_CONSUMER_GOMEMLIMIT=1150MiB
LT_KAFKA_CPUS=1.5
LT_KAFKA_MEMORY=1.25G
LT_POSTGRES_CPUS=1.5
LT_POSTGRES_MEMORY=1.25G
LT_K6_CPUS=2
